# Copy this file to android/keystore.properties (gitignored) for local release signing,
# or supply the equivalent environment variables in CI:
#   YAYTIF_KEYSTORE_PATH
#   YAYTIF_KEYSTORE_PASSWORD
#   YAYTIF_KEY_ALIAS
#   YAYTIF_KEY_PASSWORD
#
# Environment variables take precedence over values in keystore.properties.
# NEVER commit android/keystore.properties or any .jks/.keystore file to version control.

storeFile=/absolute/path/to/yaytif-upload.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=yaytif-upload
keyPassword=CHANGE_ME_KEY_PASSWORD
